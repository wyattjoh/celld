{
  "name": "queues",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "DELIVERIES", "class_name": "Deliveries" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Deliveries"] }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "example-events" }],
    "consumers": [{
      "queue": "example-events",
      "max_batch_size": 10,
      "max_batch_timeout": 1,
      "max_retries": 2,
      "retry_delay": 1
    }]
  }
}
